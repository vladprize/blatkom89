# ── БЛАТКОМ ’89 server configuration (copy to .env and fill in) ──────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Public HTTPS origin that serves the Mini App (used for invite links and WS origin checks)
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://blatkom:blatkom@127.0.0.1:5432/blatkom
# Tests only: separate database (each test file creates its own schema, so parallel runs are safe)
# DATABASE_URL_TEST=postgres://blatkom:blatkom@127.0.0.1:5432/blatkom_test
DATABASE_POOL_MAX=10
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-64-random-characters-before-running-anything-real
SESSION_TTL_HOURS=336
# Telegram bot (BotFather). Never expose the token to the client.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_SHORT_NAME=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
# Browser-only dev login (refused when NODE_ENV=production)
DEV_AUTH_ENABLED=true
# Comma-separated extra origins allowed for API/WS (normally empty: same-origin)
CORS_ORIGINS=
# Set to true behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# First admin account (created on start only if no admin exists; remove afterwards)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12
# Directory with the built web client (apps/web/dist)
STATIC_DIR=apps/web/dist
LOG_LEVEL=info
SERVER_VERSION=0.1.0
MAX_ROOMS=500
# Match rules: duration (30–900 s), point limit (elimination = 2, assist = 1), players per room (2–6)
MATCH_DURATION_SEC=240
MATCH_SCORE_LIMIT=50
MATCH_MIN_PLAYERS=2
MATCH_MAX_PLAYERS=6
