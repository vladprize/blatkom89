# ── BLATKOM ’89 server configuration (copy to .env and fill in) ───────────────
NODE_ENV=development
HOST=0.0.0.0
PORT=8080
# Public HTTPS origin that serves the game (used for invite links and WS origin checks).
# Required in production; on Render it defaults to RENDER_EXTERNAL_URL.
PUBLIC_URL=http://localhost:8080
DATABASE_URL=postgres://blatkom:blatkom@127.0.0.1:5432/blatkom
# Tests only: separate database (each test file creates its own schema, so parallel runs are safe)
# DATABASE_URL_TEST=postgres://blatkom:blatkom@127.0.0.1:5432/blatkom_test
DATABASE_POOL_MAX=10
# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=replace-with-64-random-characters-before-running-anything-real
SESSION_TTL_HOURS=336
# Telegram bot (BotFather). Never expose the token to the client. V2.0: the token and the username
# together switch on «Link Telegram» on the website (docs/TELEGRAM.md §4) and the partners' bot links.
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
TELEGRAM_MINIAPP_SHORT_NAME=
TELEGRAM_AUTH_MAX_AGE_SEC=86400
# The bot (v0.3): with a token and an https PUBLIC_URL the server registers its webhook on start-up;
# after it hands out a link the server keeps itself awake BOT_WARM_MINUTES (free hosts sleep).
BOT_WARM_MINUTES=20
# true: never sleep on a free host (the server asks its own address every 5 minutes)
KEEP_AWAKE=false
# ── Sign-in with a provider (docs/SIGN_IN.md) ────────────────────────────────
# A provider is offered only when both its keys are set. Redirect URI to register with each one:
#   <PUBLIC_URL>/api/auth/oauth/<google|discord|facebook|reddit>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# Graph API version for Facebook (change only when Facebook retires it)
FACEBOOK_GRAPH_VERSION=v23.0
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Telegram on the website (the Login Widget flow): needs TELEGRAM_BOT_TOKEN and the bot's /setdomain
TELEGRAM_WEB_LOGIN=false
# Browser-only dev login (refused when NODE_ENV=production)
DEV_AUTH_ENABLED=true
# Public website without Telegram: players sign in as guests with a nickname (device-bound, rate-limited).
# With GUEST_AUTH_ENABLED=true a production server may run without TELEGRAM_BOT_TOKEN.
GUEST_AUTH_ENABLED=false
# New guest accounts per address per hour (a party behind one Wi-Fi shares an address).
GUEST_SIGNUPS_PER_IP_HOUR=10
# Comma-separated extra origins allowed for API/WS (normally empty: same-origin)
CORS_ORIGINS=
# Set to true behind a reverse proxy that sets X-Forwarded-For
TRUST_PROXY=false
# First admin account (created on start only if no admin exists; remove afterwards)
ADMIN_BOOTSTRAP_USERNAME=
ADMIN_BOOTSTRAP_PASSWORD=
ADMIN_SESSION_TTL_HOURS=12
# Directory with the built web client (apps/web/dist)
STATIC_DIR=apps/web/dist
LOG_LEVEL=info
# SERVER_VERSION defaults to the version the server bundle was built from
# SERVER_VERSION=
MAX_ROOMS=500
# Match rules: duration (30–900 s), point limit (elimination = 2, assist = 1), players per room (2–6)
MATCH_DURATION_SEC=240
MATCH_SCORE_LIMIT=50
MATCH_MIN_PLAYERS=2
# up to 10 players per room (one map, one match)
MATCH_MAX_PLAYERS=10
# team matches (red vs blue) end at this many eliminations of one team
MATCH_TEAM_SCORE_LIMIT=40
# capture the flag: captures to win; base capture: points to win (a point per base held per second)
MATCH_CAPTURE_LIMIT=3
MATCH_BASE_SCORE_LIMIT=250
# Complete small lineups with players the server runs itself (4 in free-for-all, 3 a side in team
# modes) so a match can always start — Quick Match after a short wait, rooms with friends at kick-off.
MATCH_FILL_BOTS=true
# ── Economy and payments (docs/ECONOMY.md) ───────────────────────────────────
# Paid rare-weapon cases; set to false where paid randomised items are restricted.
CASES_ENABLED=true
# Card payments through Stripe Checkout: both keys enable them. Webhook endpoint:
#   https://<your-domain>/api/pay/stripe/webhook (events: checkout.session.completed,
#   checkout.session.async_payment_succeeded, checkout.session.async_payment_failed,
#   checkout.session.expired, charge.refunded)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Crypto payments through NOWPayments invoices: both keys enable them (IPN URL is sent per invoice).
NOWPAYMENTS_API_KEY=
NOWPAYMENTS_IPN_SECRET=
NOWPAYMENTS_SANDBOX=false
# Password-reset letters through Resend (https://resend.com). Without them the request is refused
# and an administrator can create a one-time reset link in /admin instead.
RESEND_API_KEY=
# A sender address on a domain verified in Resend, e.g. BLATKOM 89 <no-reply@your-domain>
MAIL_FROM=
# V2.0: the BLAT DROP announcement date players count down to (ISO 8601, e.g. 2027-04-23T12:00:00Z).
# Optional — an administrator sets (or clears) the date in /admin → $BLAT, which then wins. v0.2.17:
# the release sets the owner's date (8 Feb 2027, 23:00 Cyprus) as an administrator's setting.
BLAT_DROP_ANNOUNCE_AT=
# v0.2.17: the project's Solana wallet shown in BLAT DROP (default: the owner's address in the code).
# Nothing in the game sends to it or reads from it.
PROJECT_SOL_WALLET=
# v0.2.17: the menu's X and Telegram buttons (without them: «coming soon»)
SOCIAL_X_URL=
SOCIAL_TELEGRAM_URL=
# v0.2.17: $BLAT stakes in the $BLAT Tournament (true by default; false: the tournament plays for
# the rating only, rooms with a stake can't be made and nobody can join one)
TOURNAMENT_STAKES=true
